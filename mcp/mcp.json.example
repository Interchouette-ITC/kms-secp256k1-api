{
  "mcpServers": {
    "kms-secp256k1-api-http": {
      "url": "http://127.0.0.1:8789/mcp"
    },
    "kms-secp256k1-api-stdio": {
      "command": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "mcp/Cargo.toml",
        "--quiet",
        "--"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "KMS_API_ROOT": "${workspaceFolder}"
      }
    }
  }
}
