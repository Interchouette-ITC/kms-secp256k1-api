{
  "mcpServers": {
    "kms-secp256k1-api": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "-v",
        "${workspaceFolder}:/workspace",
        "-e",
        "KMS_API_ROOT=/workspace",
        "-e",
        "KMS_HOST_ROOT=${workspaceFolder}",
        "-e",
        "MCP_HTTP=false",
        "-w",
        "/workspace",
        "interchouette/kms-secp256k1-api-mcp:1.2.1",
        "kms-secp256k1-api-mcp"
      ]
    }
  }
}
